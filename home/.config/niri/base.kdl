prefer-no-csd
screenshot-path "~/Pictures/Screenshots/%Y-%m-%d %H-%M-%S.png"

output "eDP-1" {
    mode "3840x2160@60"
    scale 2.5
}

input {
    mouse {
        accel-speed -0.8
        accel-profile "flat"
    }

    touchpad {
        tap
        natural-scroll
    }

    keyboard {
        numlock
    }
}

hotkey-overlay {
    skip-at-startup
}

recent-windows {
    off
}

overview {
    zoom 0.6
    backdrop-color "#000000"
}

cursor {
    hide-when-typing
    hide-after-inactive-ms 500
    xcursor-theme "GoogleDot-Blue"
    xcursor-size 24
}

environment {
    DISPLAY ":1"
    ELECTRON_OZONE_PLATFORM_HINT "auto"

    XDG_SESSION_TYPE "wayland"
    XDG_CURRENT_DESKTOP "niri"

    QT_QPA_PLATFORM "wayland"
    QT_QPA_PLATFORMTHEME "gtk3"
    QT_WAYLAND_DISABLE_WINDOWDECORATION "1"
    QT_AUTO_SCREEN_SCALE_FACTOR "1"

    GTK_IM_MODULE "none"
}

debug {
    honor-xdg-activation-with-invalid-serial
}

layout {
    background-color "#000000"

    empty-workspace-above-first

    center-focused-column "never"
    default-column-display "tabbed"
    default-column-width { proportion 0.5; }

    preset-column-widths {
        proportion 0.333
        proportion 0.5
        proportion 0.666
    }

    gaps 18

    struts {
        left 80
        right 80
        top 60
        bottom 60
    }

    focus-ring {
        off
    }

    border {
        on
        width 3
        active-color "#cba6f7"
        inactive-color "#585b70"
    }

    shadow {
        off
    }

    insert-hint {
        off
    }

    tab-indicator {
        hide-when-single-tab
        corner-radius 4
        width 4
        position "left"
        length total-proportion=0.95
        gap 3
        gaps-between-tabs 3
    }
}

animations {
    slowdown 3.0

    overview-open-close {
        spring damping-ratio=1.0 stiffness=500 epsilon=0.0001
    }

    horizontal-view-movement {
        spring damping-ratio=1.0 stiffness=300 epsilon=0.0001
    }

    workspace-switch {
        spring damping-ratio=1.0 stiffness=300 epsilon=0.0001
    }

    window-open {
        spring damping-ratio=1.0 stiffness=500 epsilon=0.0001
    }

    window-close {
        spring damping-ratio=1.0 stiffness=300 epsilon=0.0001
    }

    window-movement {
        spring damping-ratio=1.0 stiffness=400 epsilon=0.0001
    }

    window-resize {
        spring damping-ratio=1.0 stiffness=400 epsilon=0.0001
    }

    config-notification-open-close {
        spring damping-ratio=1.0 stiffness=600 epsilon=0.001
    }

    exit-confirmation-open-close {
        spring damping-ratio=1.0 stiffness=800 epsilon=0.001
    }
}

window-rule {
    geometry-corner-radius 11
    clip-to-geometry true
}

window-rule {
    match app-id="kitty"
    default-column-width { proportion 0.8; }
}
